<?xml version="1.0" encoding="utf-8"?>
<!--
    Only settings and sound effects are backed up and moved to a new phone. The song index and the
    saved queue point at files and folder permissions that belong to this device, so restoring
    them elsewhere would only produce a library of songs that can't be opened.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/effects.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/effects.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
